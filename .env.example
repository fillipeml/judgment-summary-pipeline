# =============================================================================
# judgment-summary-pipeline. Copy to ".env" and fill in. NEVER commit the .env files.
# Every value below is a placeholder; the demo needs none of them.
# =============================================================================

# --- Demo --------------------------------------------------------------------------
# true = recorded readings, the sample workbook and the sample case files. The whole chain
# runs: chunking, the batch ids, the polling, both gates, the write and the verification.
# Only the wait and the bill are removed. Defaults to true whenever ANTHROPIC_API_KEY is
# empty, so a fresh clone cannot accidentally spend money.
DEMO_MODE=true

# --- Model (production) ------------------------------------------------------------
# Two calls per case through the Message Batches API. The model must have an entry in
# src/model/pricing.json, or the run works and every cost is reported as "unpriced" rather
# than guessed.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- The client's workbook ---------------------------------------------------------
# Never written to: every run writes a copy into OUT_DIR and then diffs it against this file.
WORKBOOK_PATH=cases/caseload.xlsx
# The summary column is found by its header text. SUMMARY_COLUMN is the fallback index, used
# only when no header matches; without either the run stops rather than guessing a column.
SUMMARY_HEADER=Resumo Decisão
SUMMARY_COLUMN=
CASE_COLUMN=1

# --- The case files ----------------------------------------------------------------
# A folder, walked recursively. Sub-folders are part of the path on purpose: on a real shared
# drive the case number is often only on the parent folder.
SOURCE_DIR=cases/documents
# Larger than this is a scanning artefact rather than a filing, and is skipped with a note.
MAX_DOCUMENT_MB=120

# --- Run state and deliverables ----------------------------------------------------
# Extracted text, maps, per-case records, reports and the delivered copy. Everything a stage
# writes here is what makes the next run resumable.
OUT_DIR=out

# --- Pacing ------------------------------------------------------------------------
# Model calls at once outside the Batch API (extraction and the audit).
CONCURRENCY=2
# Requests per batch submission. A single submission larger than this is rejected whole by
# the gateway, so a run is chunked before anything is sent.
BATCH_CHUNK_SIZE=100
# Seconds between polls of a batch. A real round takes minutes to hours.
POLL_SECONDS=120
# Linear backoff, capped. High attempt count on purpose: this sits out a few minutes of
# instability rather than abandoning a job that already cost an hour of extraction.
RETRY_ATTEMPTS=20
RETRY_MAX_MS=60000
